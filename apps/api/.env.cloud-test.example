# Copy to .env.cloud-test.local (ignored). Never paste secrets into commands/logs.
# This declaration alone does NOT verify the deployed environment.
CLOUD_TEST_ENVIRONMENT=development
CLOUD_TEST_API_ORIGIN=https://YOUR_DEVELOPMENT_WORKER.workers.dev
CLOUD_TEST_SUPABASE_PROJECT_REF=YOUR_DEVELOPMENT_PROJECT_REF
SUPABASE_URL=https://YOUR_DEVELOPMENT_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# One registered, dedicated user; acquire a fresh access token via normal Auth.
CLOUD_TEST_USER_ID=YOUR_TEST_USER_UUID
CLOUD_TEST_ACCESS_TOKEN=YOUR_SUPABASE_ACCESS_TOKEN
# Observation only. Use the application role, NOT postgres/service_role.
# Direct connection; local IPv6 required. Session pooler alternative below.
CLOUD_TEST_DATABASE_URL="postgresql://book_bear_api:ENCODED_PASSWORD@db.YOUR_DEVELOPMENT_PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt"
# Session pooler: book_bear_api.PROJECT_REF@POOLER_HOST:5432/postgres
# Retain sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt in either case.
