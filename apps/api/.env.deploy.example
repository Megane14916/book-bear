# Copy to .env.deploy.local (ignored by Git).
# The remote/deploy scripts read this file; only SUPABASE_URL/CORS_ORIGIN
# are copied to Workers runtime variables. HYPERDRIVE_ID configures the binding.
# Use the ID of your cache-disabled Hyperdrive configuration.
HYPERDRIVE_ID=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
CORS_ORIGIN=http://localhost:5173
