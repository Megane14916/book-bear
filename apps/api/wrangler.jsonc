{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "book-bear-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-18",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace with your cache-disabled Hyperdrive ID before deploying.
      "id": "00000000000000000000000000000000",
      // Local-only PGlite uses placeholder credentials. Override via
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE for Supabase.
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5433/postgres"
    }
  ]
}
