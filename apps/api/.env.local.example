# Copy to .env.local (ignored by Git). Read by Wrangler for local API startup.
# Use the development database's application role and a URL-encoded password.
# Session pooler: copy the host and project reference from Supabase Connect.
# Relative certificate paths resolve from apps/api when using pnpm dev:api.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://book_bear_api.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt"

# API runtime settings and GOOGLE_BOOKS_API_KEY belong in .dev.vars.
# MIGRATION_DATABASE_URL belongs in .env.db.local, not here.
