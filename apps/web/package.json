{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ../../contracts/openapi.json -o src/lib/api/generated.ts",
    "check:api": "openapi-typescript ../../contracts/openapi.json -o src/lib/api/generated.ts --check"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "openapi-typescript": "^7.8.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
