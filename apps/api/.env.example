# Copy to .env.local (ignored by Git). Used only by CLI migration commands.
# Local PGlite: run pnpm --filter api db:local first.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Supabase development DB: use the administrative/migration connection locally.
# MIGRATION_DATABASE_URL=postgresql://postgres:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full
# If needed, append &sslrootcert=PATH_TO_DOWNLOADED_SUPABASE_CA_CERT
# Do not put MIGRATION_DATABASE_URL in Workers, Pages or VITE_ variables.
