# Copy to .env.auth.local for the user-run auth:google CLI (ignored by Git).
# This file is NOT loaded by Wrangler or sent to Workers.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
GOOGLE_OIDC_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
API_BASE_URL=http://127.0.0.1:8787
OIDC_CALLBACK_PORT=8790
# Only needed for `link` when anonymous signup requires CAPTCHA.
# Obtain a fresh captcha token yourself; never commit it.
# AUTH_CAPTCHA_TOKEN=
